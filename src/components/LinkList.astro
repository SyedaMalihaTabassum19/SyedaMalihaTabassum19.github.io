---
// External resource links (repository, demo, report…) with hosting credits.
import Icon, { type IconName } from './Icon.astro';

interface Link {
  label: string;
  url: string;
  kind: 'repository' | 'website' | 'video' | 'report' | 'paper' | 'doi' | 'other';
  hostedBy?: string;
}

interface Props {
  links: Link[];
  /** Used to make link text unique for screen readers. */
  context: string;
}

const { links, context } = Astro.props;
const icons: Record<Link['kind'], IconName> = {
  repository: 'github',
  website: 'globe',
  video: 'video',
  report: 'document',
  paper: 'document',
  doi: 'document',
  other: 'link',
};
---

<ul class="links">
  {
    links.map((link) => (
      <li>
        <a href={link.url} target="_blank" rel="noopener noreferrer">
          <span class="icon-wrap">
            <Icon name={icons[link.kind]} size={20} />
          </span>
          <span class="text">
            <span class="label">
              {link.label}
              <span class="visually-hidden">
                — {context} (opens in a new tab)
              </span>
            </span>
            <span class="host">{link.hostedBy ? `Hosted by ${link.hostedBy}` : new URL(link.url).hostname.replace(/^www\./, '')}</span>
          </span>
          <Icon name="arrow-up-right" class="go" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    transition:
      border-color var(--dur),
      transform var(--dur) var(--ease-out);
  }

  a:hover {
    border-color: var(--accent);
    color: var(--ink);
    transform: translateX(2px);
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--wash);
    color: var(--accent);
    flex: none;
  }

  .text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .label {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .host {
    font-size: var(--step--2);
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  a :global(.go) {
    flex: none;
    color: var(--muted);
    transition: transform var(--dur) var(--ease-out), color var(--dur);
  }

  a:hover :global(.go) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
</style>
