---
// One research entry as an editorial row with an inline, expandable details
// panel. `feature` renders the published paper prominently with its citation.
// Deep link: #research-<id> (the panel opens automatically).
import AuthorList from './AuthorList.astro';
import CitationBlock from './CitationBlock.astro';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import { labelFor, researchStatuses, researchTopics, researchTypes } from '@/data/taxonomy';
import type { Research } from '@/lib/content';
import { withBase } from '@/lib/url';

interface Props {
  entry: Research;
  feature?: boolean;
}

const { entry, feature = false } = Astro.props;
const d = entry.data;
const anchor = `research-${entry.id}`;
const panelId = `${anchor}-details`;
const searchText = [d.title, d.summary, d.authors.join(' '), d.venue, d.submittedTo, ...d.topics.map((t) => labelFor(researchTopics, t))]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
const venueLine = [d.venue, d.publisher, d.pages && `pp. ${d.pages}`].filter(Boolean).join(', ');
const doiLink = d.links.find((l) => l.kind === 'doi');
const otherLinks = d.links.filter((l) => l.kind !== 'doi');
const statusNote = researchStatuses.find((s) => s.id === d.status)?.note;
const when = d.year ? String(d.year) : d.status === 'in-progress' ? 'Ongoing' : 'Submitted';
---

<li
  class:list={['row', { 'row--feature': feature }]}
  id={anchor}
  data-filter-item
  data-status={d.status}
  data-topic={d.topics.join(' ')}
  data-search={searchText}
  data-reveal
>
  <div class="meta">
    <span class="when mono">{when}</span>
    <StatusBadge status={d.status} />
    <span class="type">{labelFor(researchTypes, d.type)}</span>
  </div>

  <div class="main">
    {feature && <p class="eyebrow eyebrow--accent">Featured publication</p>}
    <h4 class="title">{d.title}</h4>
    {d.authors.length > 0 && <AuthorList authors={d.authors} />}
    {venueLine && <p class="venue">{venueLine}</p>}
    {
      d.submittedTo && (
        <p class="venue">
          Submitted to <strong>{d.submittedTo}</strong> — under review
        </p>
      )
    }
    {feature && <p class="summary">{d.summary}</p>}
    <ul class="chip-list" aria-label="Topics">
      {d.topics.map((t) => <li class="chip">{labelFor(researchTopics, t)}</li>)}
    </ul>

    {
      feature && (
        <div class="feature-actions">
          {doiLink && (
            <a class="btn btn--primary btn--small" href={doiLink.url} target="_blank" rel="noopener noreferrer">
              Read via DOI <Icon name="arrow-up-right" />
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          )}
        </div>
      )
    }
    {feature && d.citation && <CitationBlock id={entry.id} citation={d.citation} bibtex={d.bibtex} />}
  </div>

  {
    !feature && (
      <>
        <div class="action">
          <button
            class="toggle"
            type="button"
            aria-expanded="true"
            aria-controls={panelId}
            data-expander-toggle
            hidden
          >
            <span data-label-open="Hide details" data-label-closed="Details">
              Hide details
            </span>
            <span class="toggle-icon" aria-hidden="true">
              <Icon name="plus" />
            </span>
            <span class="visually-hidden">: {d.shortTitle ?? d.title}</span>
          </button>
        </div>

        <div class="expander details" id={panelId} data-expander role="region" aria-label={`Details: ${d.shortTitle ?? d.title}`}>
          <div class="expander-inner">
            <div class="details-body">
              <div>
                <h5>Summary</h5>
                <p>{d.summary}</p>
              </div>
              <div>
                <h5>Publication status</h5>
                <p>
                  {d.status === 'under-review' ? (
                    <>
                      Submitted to <em>{d.submittedTo}</em> and under peer review. It has not been accepted.
                    </>
                  ) : (
                    statusNote
                  )}
                </p>
              </div>
              {(doiLink || otherLinks.length > 0) && (
                <ul class="links">
                  {[...(doiLink ? [doiLink] : []), ...otherLinks].map((l) => (
                    <li>
                      <a class="text-link" href={l.url} target="_blank" rel="noopener noreferrer">
                        {l.label} <Icon name="arrow-up-right" />
                        <span class="visually-hidden">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {d.citation && <CitationBlock id={entry.id} citation={d.citation} bibtex={d.bibtex} />}
              <a class="permalink" href={withBase(`#${anchor}`)}>
                <Icon name="link" /> Link to this entry
              </a>
            </div>
          </div>
        </div>
      </>
    )
  }
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-top: 0.2rem;
  }

  .when {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--text);
  }

  .type {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .main {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .title {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 62ch;
  }

  .venue {
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .venue strong {
    color: var(--text);
  }

  .summary {
    color: var(--text-2);
    max-width: 68ch;
  }

  .action {
    padding-top: 0.1rem;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.4rem 0.35rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text);
    font-weight: 700;
    font-size: var(--step--1);
    white-space: nowrap;
    transition:
      border-color var(--fast),
      color var(--fast);
  }

  .toggle:hover,
  .toggle[aria-expanded='true'] {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .details {
    grid-column: 2 / -1;
  }

  .details-body {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
    padding: var(--s-3);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
  }

  h5 {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.3rem;
  }

  .details-body p {
    color: var(--text-2);
    max-width: 70ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .permalink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    width: fit-content;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .permalink :global(svg) {
    width: 1em;
    height: 1em;
  }

  /* Featured published paper */
  .row--feature {
    grid-template-columns: 11rem minmax(0, 1fr);
    margin-bottom: var(--s-2);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .row--feature .title {
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-1);
  }

  .row--feature :global(.citation) {
    margin-top: var(--s-1);
    background: var(--bg);
  }

  .row:target,
  .row:has(:target) {
    animation: flash 1.6s var(--ease);
  }

  @keyframes flash {
    from {
      background-color: var(--accent-soft);
    }
  }

  @media (max-width: 52rem) {
    .row,
    .row--feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 1rem;
    }

    .details {
      grid-column: 1;
    }

    .action {
      padding-top: var(--s-1);
    }
  }

  @media (max-width: 40rem) {
    .row--feature {
      padding: var(--s-3);
    }
  }
</style>
