---
import Icon from './Icon.astro';
import { sections } from '@/data/navigation';
import { profile } from '@/data/profile';
import { getWriting } from '@/lib/content';
import { stripBase, withBase } from '@/lib/url';

const path = stripBase(Astro.url.pathname);
const hasWriting = (await getWriting()).length > 0;
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="logo" href={withBase('#home')} aria-label={`${profile.name} — home`}>
      <span class="logo-mark">Maliha</span><span class="logo-dot" aria-hidden="true">.</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Sections" data-menu>
      <ul>
        {
          sections.map((item, i) => (
            <li class:list={{ secondary: !item.primary }} style={`--i:${i}`}>
              <a href={withBase(`#${item.id}`)} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          hasWriting && (
            <li class="secondary" style={`--i:${sections.length}`}>
              <a href={withBase('writing/')} aria-current={path === '/writing/' ? 'page' : undefined}>
                Writing
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <div class="tools">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle hidden>
        <Icon name="sun" size={18} class="to-light" />
        <Icon name="moon" size={18} class="to-dark" />
        <span class="visually-hidden" data-theme-label>Switch theme</span>
      </button>
      <a class="btn btn--primary btn--small cta" href={withBase('#contact')}>Get in touch</a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
        hidden
      >
        <Icon name="menu" size={20} class="when-closed" />
        <Icon name="close" size={20} class="when-open" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  :global(.is-scrolled) .site-header {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .logo-mark {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .logo-dot {
    color: var(--text);
  }

  .site-nav ul {
    display: flex;
    gap: clamp(0.25rem, 1.6vw, 1.75rem);
    padding: 0;
    list-style: none;
  }

  .site-nav li.secondary {
    display: none;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.35rem;
    color: var(--text-2);
    font-weight: 400;
    text-decoration: none;
    transition: color var(--fast);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 0.45rem;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--fast) var(--ease);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--text);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    transform: scaleX(0.5);
  }

  .site-nav a[aria-current] {
    color: var(--accent-text);
    font-weight: 700;
  }

  .site-nav a[aria-current]::after {
    transform: scaleX(1);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    transition:
      border-color var(--fast),
      color var(--fast);
  }

  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  :global([data-effective-theme='dark']) .theme-toggle :global(.to-dark),
  :global([data-effective-theme='light']) .theme-toggle :global(.to-light) {
    display: none;
  }

  .menu-toggle :global(.when-open),
  .menu-toggle[aria-expanded='true'] :global(.when-closed) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.when-open) {
    display: block;
  }

  /* ── Compact screens ──────────────────────────────────────────────── */
  @media (max-width: 63.99rem) {
    .bar {
      flex-wrap: wrap;
      gap: var(--s-1) var(--s-2);
    }

    /* Without JS the links wrap below the bar. */
    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav ul {
      flex-wrap: wrap;
      gap: 0 var(--s-2);
    }

    .site-nav li.secondary {
      display: list-item;
    }

    .cta {
      display: none;
    }

    /* With JS: a dropdown panel under the bar. */
    :global(.js) .bar {
      flex-wrap: nowrap;
    }

    :global(.js) .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: auto;
      padding: var(--s-2) var(--gutter) var(--s-4);
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 200ms ease,
        transform 200ms var(--ease),
        visibility 0s linear 200ms;
    }

    :global(.js) .site-nav[data-open] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms ease,
        transform 200ms var(--ease);
    }

    :global(.js) .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .site-nav li {
      border-bottom: 1px solid var(--border);
    }

    :global(.js) .site-nav a {
      width: 100%;
      min-height: 3.25rem;
      font-size: var(--step-1);
      padding-inline: 0;
    }

    :global(.js) .site-nav a::after {
      left: 0;
      right: auto;
      width: 1.5rem;
      bottom: 0.6rem;
    }
  }

  @media (min-width: 64rem) {
    .menu-toggle {
      display: none !important;
    }
  }
</style>
