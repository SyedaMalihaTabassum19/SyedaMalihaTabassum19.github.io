---
// Education & Recognition: two complementary columns of compact rows.
import Icon, { type IconName } from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { awardCategories, labelFor } from '@/data/taxonomy';
import { getAwards, getEducation } from '@/lib/content';
import { formatMonth, formatRange } from '@/lib/format';

const education = await getEducation();
const awards = await getAwards();
const ordered = awardCategories.flatMap((c) => awards.filter((a) => a.data.category === c.id));
// A Google Drive share link → its embeddable preview URL (other links preview as-is).
const previewUrl = (url: string) => {
  const id = url.match(/drive\.google\.com\/file\/d\/([^/?#]+)/)?.[1];
  return id ? `https://drive.google.com/file/d/${id}/preview` : url;
};
const hasDocuments = awards.some((a) => a.data.document);

const iconFor: Record<string, IconName> = {
  academic: 'award',
  competition: 'trophy',
  'personal-development': 'rocket',
};
---

<section class="section section--alt" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <SectionHeading
      id="education-title"
      title="Education & Recognition"
      sub="Qualifications and results, scholarships, distinctions and competition achievements."
    />

    <div class="cols">
      <div class="col" data-reveal>
        <h3 class="col-title"><Icon name="cap" /> Education</h3>
        <ol class="list">
          {
            education.map((e) => (
              <li class="item card">
                <div class="item-main">
                  <p class="mono muted">{formatRange(e.data.start, e.data.end)}</p>
                  <h4>{e.data.qualification}</h4>
                  <p class="sub">{e.data.institution}</p>
                </div>
                {e.data.result && (
                  <p class="result">
                    <span class="result-value">{e.data.result.value}</span>
                    <span class="result-label">
                      {e.data.result.label} / {e.data.result.scale}
                    </span>
                  </p>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="col" data-reveal style="--reveal-step:1">
        <h3 class="col-title"><Icon name="award" /> Recognition</h3>
        <ol class="list list--awards">
          {
            ordered.map((a) => (
              <li class="award">
                <span class="award-icon" aria-hidden="true">
                  <Icon name={iconFor[a.data.category] ?? 'award'} />
                </span>
                <div class="award-main">
                  <p class="award-title">
                    {a.data.result && <strong class="accent">{a.data.result} — </strong>}
                    {a.data.title}
                  </p>
                  <p class="sub">
                    {a.data.organiser} · <span class="visually-hidden">{labelFor(awardCategories, a.data.category)} · </span>
                    <span class="mono">
                      {a.data.start ? formatRange(a.data.start, a.data.date) : formatMonth(a.data.date)}
                    </span>
                  </p>
                </div>
                {a.data.document && (
                  <a
                    class="doc-btn"
                    href={a.data.document.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-doc-preview={previewUrl(a.data.document.url)}
                    data-doc-title={`${a.data.result ? `${a.data.result} — ` : ''}${a.data.title}`}
                  >
                    <Icon name="certificate" />
                    <span class="doc-label">{a.data.document.label}</span>
                    <span class="visually-hidden">: {a.data.title}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  {
    hasDocuments && (
      <dialog class="doc-dialog" aria-labelledby="doc-dialog-title" data-doc-dialog>
        <div class="doc-head">
          <p id="doc-dialog-title" class="doc-title" data-doc-dialog-title>
            Certificate
          </p>
          <div class="doc-actions">
            <a class="btn btn--primary btn--small" href="#" target="_blank" rel="noopener noreferrer" data-doc-open>
              <Icon name="external" /> Open in Google Drive
              <span class="visually-hidden">(opens in a new tab, where you can download it)</span>
            </a>
            <button class="btn btn--small" type="button" data-doc-close>
              <Icon name="close" /> Close
            </button>
          </div>
        </div>
        <div class="doc-frame">
          <iframe title="Certificate preview" loading="lazy" data-doc-frame />
        </div>
      </dialog>
    )
  }
</section>

<script>
  // Opens a certificate in an in-page preview. Without JS the button is a
  // normal link to Google Drive. The Drive preview is only requested when the
  // visitor asks for it.
  const dialog = document.querySelector<HTMLDialogElement>('[data-doc-dialog]');
  const frame = dialog?.querySelector<HTMLIFrameElement>('[data-doc-frame]');
  const title = dialog?.querySelector<HTMLElement>('[data-doc-dialog-title]');
  const open = dialog?.querySelector<HTMLAnchorElement>('[data-doc-open]');
  let trigger: HTMLElement | null = null;

  if (dialog && frame && title && open && typeof dialog.showModal === 'function') {
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-doc-preview]');
      if (!link) return;
      event.preventDefault();
      trigger = link;
      title.textContent = link.dataset.docTitle ?? 'Certificate';
      frame.title = `Preview: ${link.dataset.docTitle ?? 'certificate'}`;
      frame.src = link.dataset.docPreview!;
      open.href = link.href;
      dialog.showModal();
    });
    dialog.querySelector('[data-doc-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      frame.src = 'about:blank';
      trigger?.focus();
    });
  }
</script>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--s-6);
    align-items: start;
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
    margin-bottom: var(--s-3);
  }

  .col-title :global(svg) {
    color: var(--accent);
    width: 1.3em;
    height: 1.3em;
  }

  .list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
  }

  .item-main {
    display: grid;
    gap: 0.2rem;
  }

  .item h4 {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .sub {
    color: var(--text-2);
    font-size: var(--step--1);
  }

  .result {
    display: grid;
    justify-items: end;
    text-align: right;
    flex: none;
  }

  .result-value {
    font-size: var(--step-3);
    font-weight: 900;
    line-height: 1;
    color: var(--accent-text);
  }

  .result-label {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    color: var(--muted);
  }

  .list--awards {
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .award {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-2);
    align-items: start;
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--border);
  }

  .award-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .award-icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .award-title {
    font-weight: 700;
    line-height: 1.4;
  }

  /* Glassy certificate button */
  .award {
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
  }

  .doc-btn {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.16));
    background: light-dark(rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.06));
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 light-dark(rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.12)),
      0 8px 20px -14px rgb(0 0 0 / 0.6);
    color: var(--text);
    font-size: var(--step--2);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--fast),
      background-color var(--fast),
      transform var(--fast) var(--ease);
  }

  .doc-btn:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
    transform: translateY(-1px);
  }

  .doc-btn :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent-text);
  }

  /* Preview dialog */
  .doc-dialog {
    width: min(64rem, 94vw);
    height: min(48rem, 90vh);
    padding: 0;
    border: 1px solid light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.14));
    border-radius: 16px;
    background: light-dark(rgb(255 255 255 / 0.85), rgb(24 24 24 / 0.82));
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    color: var(--text);
    overflow: hidden;
  }

  .doc-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .doc-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
  }

  .doc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-2);
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--border);
  }

  .doc-title {
    font-weight: 700;
  }

  .doc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .doc-frame {
    flex: 1;
    min-height: 0;
    background: var(--bg-alt);
  }

  .doc-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 56rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .award {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .doc-btn {
      grid-column: 2;
      justify-self: start;
    }

    .item {
      flex-direction: column;
      align-items: flex-start;
    }

    .result {
      justify-items: start;
      text-align: left;
    }
  }
</style>
