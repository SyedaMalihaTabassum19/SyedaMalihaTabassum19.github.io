---
// Timeline: dates in a narrow column, a thin rule with orange markers, role
// and organisation in the main column, contributions underneath. Includes the
// engineering-team activity (Mars rover).
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { experienceKinds, labelFor } from '@/data/taxonomy';
import { getExperience } from '@/lib/content';
import { formatMonth } from '@/lib/format';
import { withBase } from '@/lib/url';

const experience = await getExperience();
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <SectionHeading
      id="experience-title"
      title="Experience"
      sub="Industry, research, teaching and engineering-team work — newest first."
    />

    <ol class="timeline">
      {
        experience.map((e, i) => (
          <li class="entry" id={e.id} data-reveal style={`--reveal-step:${i % 2}`}>
            <p class="when mono">
              <time datetime={e.data.start}>{formatMonth(e.data.start)}</time>
              <span aria-hidden="true"> – </span>
              <span class="visually-hidden"> to </span>
              {e.data.end ? <time datetime={e.data.end}>{formatMonth(e.data.end)}</time> : 'present'}
            </p>
            <span class="marker" aria-hidden="true" />
            <div class="what">
              <p class="kind">{labelFor(experienceKinds, e.data.kind)}</p>
              <h3>{e.data.role}</h3>
              <p class="org">
                {e.data.organisation}
                {e.data.unit && <span class="muted"> · {e.data.unit}</span>}
              </p>
              <ul class="highlights">
                {e.data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="next" data-reveal>
      <a class="text-link" href={withBase('#education')}>
        Education &amp; recognition <Icon name="arrow-right" />
      </a>
    </p>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 2rem minmax(0, 1fr);
    gap: 0 var(--s-2);
    padding-bottom: var(--s-6);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  /* Thin vertical rule */
  .entry::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: -0.5rem;
    left: calc(11rem + var(--s-2) + 1rem - 0.5px);
    width: 1px;
    background: var(--border-strong);
  }

  .entry:last-child::before {
    bottom: auto;
    height: 2.5rem;
    background: linear-gradient(var(--border-strong), transparent);
  }

  .when {
    padding-top: 0.15rem;
    text-align: right;
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .marker {
    position: relative;
    justify-self: center;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--bg);
  }

  .entry:not(:first-child) .marker {
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .what {
    display: grid;
    gap: 0.35rem;
  }

  .kind {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .what h3 {
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .org {
    font-weight: 700;
    color: var(--text-2);
  }

  .highlights {
    margin-top: 0.4rem;
    padding-left: 1.1em;
    display: grid;
    gap: 0.4rem;
    color: var(--text-2);
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .entry:target .what {
    animation: flash 1.6s var(--ease);
    border-radius: var(--radius);
  }

  @keyframes flash {
    from {
      background-color: var(--accent-soft);
    }
  }

  .next {
    margin-top: var(--s-6);
    text-align: center;
  }

  @media (max-width: 44rem) {
    .entry {
      grid-template-columns: 1.25rem minmax(0, 1fr);
      gap: 0.25rem var(--s-2);
    }

    .entry::before {
      left: calc(0.625rem - 0.5px);
    }

    .when {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
    }

    .marker {
      grid-column: 1;
      grid-row: 1;
    }

    .what {
      grid-column: 2;
    }
  }
</style>
