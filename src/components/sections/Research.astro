---
import FilterControls from '@/components/FilterControls.astro';
import ResearchRow from '@/components/ResearchRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { researchStatuses, researchTopics } from '@/data/taxonomy';
import { getResearch } from '@/lib/content';

const research = await getResearch();
const statuses = researchStatuses
  .map((s) => ({ ...s, entries: research.filter((r) => r.data.status === s.id) }))
  .filter((s) => s.entries.length > 0);
const topics = researchTopics
  .map((t) => ({ id: t.id, label: t.label, count: research.filter((r) => r.data.topics.includes(t.id)).length }))
  .filter((t) => t.count > 0);
// The research lifecycle, left to right: ongoing → submitted → published.
const pipeline = [...statuses].reverse();
const variantFor = (status: string, featured: boolean) =>
  (status === 'published' || status === 'accepted') && featured ? 'feature' : 'row';
---

<section class="section" id="research" aria-labelledby="research-title">
  <div class="wrap">
    <SectionHeading
      id="research-title"
      title="Research & Publications"
      sub="When should a model commit — and when should it abstain? My work spans reliable and calibrated AI, 3D perception, health AI and assistive agentic systems."
    />

    <!-- Where the work stands -->
    <ol class="pipeline" aria-label="Where the work stands" style={`--n:${pipeline.length}`} data-reveal>
      {
        pipeline.map((s) => (
          <li class={`stage stage--${s.id}`}>
            <span class="stage-count">{s.entries.length}</span>
            <span class="stage-text">
              <StatusBadge status={s.id} />
              <span class="stage-note">{s.note}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div data-filter-root data-filter-noun="entry|entries">
      <FilterControls
        idPrefix="research"
        searchLabel="Search titles, topics, venues and authors"
        searchPlaceholder="Search titles, topics, authors"
        facets={[
          {
            name: 'status',
            legend: 'Status',
            total: research.length,
            options: statuses.map((s) => ({ id: s.id, label: s.label, count: s.entries.length })),
          },
          { name: 'topic', legend: 'Topic', total: research.length, options: topics, control: 'select' },
        ]}
      />

      <p class="count mono" data-filter-count role="status" aria-live="polite" aria-atomic="true">
        {research.length} entries
      </p>

      {
        statuses.map((s) => (
          <div class={`group group--${s.id}`} data-filter-group>
            <h3 class="group-title" id={`group-${s.id}`}>
              {s.label} <span class="mono muted">({s.entries.length})</span>
            </h3>
            {s.entries.some((e) => variantFor(s.id, e.data.featured) === 'row') && (
              <p class="ledger-head mono" aria-hidden="true">
                <span>No.</span>
                <span>Title</span>
                <span>Stage</span>
              </p>
            )}
            <ol class:list={['list', `list--${s.id}`]} aria-labelledby={`group-${s.id}`}>
              {s.entries.map((entry, i) => (
                <ResearchRow entry={entry} variant={variantFor(s.id, entry.data.featured)} index={i} />
              ))}
            </ol>
          </div>
        ))
      }

      <div class="empty" data-filter-empty hidden>
        <p class="empty-title">No research matches those filters.</p>
        <p class="muted">Try another status or topic, or a shorter search term.</p>
        <button type="button" class="btn btn--primary" data-filter-reset>Reset filters</button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Pipeline: ongoing → submitted → published ── */
  .pipeline {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-6);
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .stage {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Arrow to the next stage */
  .stage:not(:last-child)::after {
    content: '';
    position: absolute;
    right: calc(var(--s-4) / -2 - 0.35rem);
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 2px solid var(--border-strong);
    border-right: 2px solid var(--border-strong);
    transform: translateY(-50%) rotate(45deg);
  }

  .stage-count {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 2px solid var(--status-color);
    background: color-mix(in srgb, var(--status-color) 10%, transparent);
    color: var(--text);
    font-size: var(--step-2);
    font-weight: 900;
  }

  .stage--published,
  .stage--accepted {
    --status-color: var(--status-published);
  }

  .stage--under-review {
    --status-color: var(--status-review);
  }

  .stage--in-progress {
    --status-color: var(--status-progress);
  }

  .stage-text {
    display: grid;
    gap: 0.2rem;
  }

  .stage-note {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.4;
  }

  .count {
    margin-block: var(--s-3) var(--s-2);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .group + .group {
    margin-top: var(--s-6);
  }

  .group-title {
    font-size: var(--step-2);
    margin-bottom: var(--s-2);
  }

  .group-title .mono {
    font-size: var(--step--1);
  }

  .list {
    display: grid;
    gap: var(--s-3);
    padding: 0;
    list-style: none;
  }

  /* Ledger: ruled rows, no cards */
  .list:has(> :global(.entry--row)) {
    gap: 0;
    border-top: 1px solid var(--border-strong);
  }

  .ledger-head {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 13rem 7.5rem;
    gap: var(--s-3);
    padding: 0 var(--s-2) 0.5rem;
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--s-1);
    margin-top: var(--s-3);
    padding: var(--s-6) var(--s-4);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-l);
  }

  .empty-title {
    font-size: var(--step-2);
    font-weight: 700;
  }

  @media (max-width: 60rem) {
    .ledger-head {
      display: none;
    }
  }

  @media (max-width: 44rem) {
    .pipeline {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .stage:not(:last-child)::after {
      right: auto;
      left: 1.35rem;
      top: auto;
      bottom: calc(var(--s-2) / -2 - 0.45rem);
      transform: rotate(135deg);
    }
  }
</style>
