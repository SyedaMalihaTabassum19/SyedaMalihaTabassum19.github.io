---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Monogram from '@/components/Monogram.astro';
import Icon from '@/components/Icon.astro';
import ContactBand from '@/components/ContactBand.astro';
import { Image } from 'astro:assets';
import { profile } from '@/data/profile';
import { getEducation } from '@/lib/content';
import { formatRange } from '@/lib/format';
import { withBase } from '@/lib/url';

const [degree] = await getEducation();
---

<BaseLayout
  title="About"
  description="Background, research interests and direction of Syeda Maliha Tabassum, a computer science graduate and AI researcher from BRAC University."
>
  <PageHeader
    eyebrow="About"
    title="Computer science graduate, AI researcher, systems builder."
    lead="I’m a computer science graduate and researcher working at the intersection of multimodal AI, agentic systems, and reliable decision-making."
  />

  <section class="section">
    <div class="wrap about-grid">
      <aside class="portrait-col" aria-label="At a glance">
        {
          profile.portrait ? (
            <Image class="portrait" src={profile.portrait.src} alt={profile.portrait.alt} width={480} loading="eager" />
          ) : (
            <div class="identity-mark" aria-hidden="true">
              <Monogram size={220} />
            </div>
          )
        }
        <dl class="glance">
          <div>
            <dt>Based in</dt>
            <dd><Icon name="pin" /> {profile.location}</dd>
          </div>
          {
            degree && (
              <div>
                <dt>Education</dt>
                <dd>
                  {degree.data.qualification}, {degree.data.institution}
                  <span class="mono muted">{formatRange(degree.data.start, degree.data.end)}</span>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          </div>
          {
            profile.links.map((link) => (
              <div>
                <dt>{link.label}</dt>
                <dd>
                  <a href={link.url} target="_blank" rel="noopener noreferrer me">
                    {link.handle}
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
        {
          profile.cv && (
            <a class="btn" href={withBase(profile.cv.path)} download>
              <Icon name="download" /> {profile.cv.label}
            </a>
          )
        }
      </aside>

      <div class="story prose">
        <h2 class="visually-hidden">Background</h2>
        <p class="first">
          My work focuses on human-centered sensing, assistive intelligence, edge–cloud AI systems, and automation, with
          a growing interest in AI evaluation, calibration, and sequential decision-making under uncertainty.
        </p>
        <p>
          I completed a B.Sc. in Computer Science and Engineering at BRAC University (September 2022 – September 2026)
          with a CGPA of 3.93 out of 4.00, on a merit-based academic scholarship and on the Dean’s List and Vice
          Chancellor’s List.
        </p>
        <p>
          On the research side, I co-authored a peer-reviewed IEEE JCSSE 2026 paper on a vision-based hand
          gesture keyboard–mouse framework with bilingual next-word prediction. Manuscripts now under review examine when
          available camera motions can — and cannot — identify a scene’s 3D physical geometry, camera-agnostic monocular
          metric 3D detection, calibrated and interpretable autism classification from functional connectomes, and the
          evidence base for vision-based fall detection.
        </p>
        <p>
          Alongside the research, I build physical systems: a microcontroller-free obstacle avoider made from
          discrete logic, a dual-ESP32 mobile manipulator that localises itself from ArUco markers, a wearable health
          monitor with GSM/GPS alerts, and the vision, networking and mechanical subsystems of BRAC University’s Mars
          rover team, Mongoltori.
        </p>
        <p>
          I’ve also worked in industry and in the classroom. As a NEXTERN in Grameenphone’s Technology Infrastructure
          Management team, I automated deployment and connectivity monitoring and weekly reporting for rectifiers and
          Li-Ion batteries using Huawei NetEco. As an
          undergraduate teaching assistant for Data Structures, I mentored more than 250 students through laboratory
          sessions and one-to-one guidance.
        </p>

        <h2>Where I’m heading</h2>
        <p>
          I’m particularly interested in building and evaluating AI systems that can support robust real-world decisions
          in high-stakes and human-centered environments — systems whose confidence means something, and that can
          recognise when they should not decide at all.
        </p>
        {
          profile.availability && (
            <p class="availability-note">
              <strong>{profile.availability.label}.</strong> If your group works on related problems, I’d be glad to hear
              from you — <a href={`mailto:${profile.email}`}>email me</a>.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="interests-title">
    <div class="wrap interests">
      <div>
        <p class="eyebrow eyebrow--accent">Research interests</p>
        <h2 id="interests-title">What I want to work on next</h2>
      </div>
      <ul class="interest-list">
        {profile.interests.map((interest, i) => <li data-reveal style={`--reveal-step:${i % 3}`}>{interest}</li>)}
      </ul>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 20rem) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .portrait-col {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: var(--space-m);
  }

  .identity-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background:
      radial-gradient(70% 60% at 70% 20%, var(--accent-glow), transparent 70%),
      repeating-radial-gradient(circle at 50% 50%, transparent 0 18px, color-mix(in srgb, var(--ink) 6%, transparent) 18px 19px),
      var(--bg-elev);
    color: var(--ink);
  }

  .identity-mark :global(svg) {
    width: 62%;
    height: auto;
  }

  .portrait-col :global(.portrait) {
    border-radius: var(--radius-l);
    width: 100%;
  }

  .glance {
    display: grid;
    gap: var(--space-s);
    font-size: var(--step--1);
  }

  .glance dt {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .glance dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 0.15rem;
    overflow-wrap: anywhere;
  }

  .story {
    font-size: var(--step-0);
  }

  .story .first {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
  }

  .story p {
    color: var(--ink-soft);
  }

  .story .availability-note {
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--accent);
    background: var(--wash);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--ink);
  }

  .interests {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: var(--space-l);
  }

  .interests h2 {
    font-size: var(--step-3);
    margin-top: var(--space-xs);
  }

  .interest-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0;
    border-top: 1px solid var(--line-strong);
  }

  .interest-list li {
    padding: var(--space-s) var(--space-s) var(--space-s) 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display-stack);
    font-size: var(--step-1);
  }

  @media (max-width: 56rem) {
    .about-grid,
    .interests {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .portrait-col {
      position: static;
      grid-template-columns: minmax(8rem, 11rem) 1fr;
      align-items: start;
    }

    .portrait-col .btn {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 30rem) {
    .portrait-col {
      grid-template-columns: 1fr;
    }

    .identity-mark {
      aspect-ratio: 2 / 1;
    }

    .identity-mark :global(svg) {
      width: auto;
      height: 70%;
    }
  }
</style>
