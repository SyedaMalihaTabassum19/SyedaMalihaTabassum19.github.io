---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactBand from '@/components/ContactBand.astro';
import { experienceKinds, labelFor } from '@/data/taxonomy';
import { getExperience } from '@/lib/content';
import { formatMonth } from '@/lib/format';

const experience = await getExperience();
---

<BaseLayout
  title="Experience"
  description="Industry, research, teaching and engineering-team experience of Syeda Maliha Tabassum — Grameenphone, BRAC University research and teaching, and the Mongoltori Mars rover team."
>
  <PageHeader
    eyebrow="Experience"
    title="Industry, research, teaching and team engineering"
    lead="Roles at Grameenphone and BRAC University, and on the university’s Mars rover team — newest first."
  />

  <section class="section">
    <div class="wrap">
      <ol class="timeline">
        {
          experience.map((e) => (
            <li class="entry" id={e.id} data-reveal>
              <div class="when">
                <span class="kind">{labelFor(experienceKinds, e.data.kind)}</span>
                <span class="dates mono">
                  <time datetime={e.data.start}>{formatMonth(e.data.start)}</time>
                  {' – '}
                  {e.data.end ? <time datetime={e.data.end}>{formatMonth(e.data.end)}</time> : 'present'}
                </span>
              </div>
              <div class="what">
                <h2>{e.data.role}</h2>
                <p class="org">
                  {e.data.organisation}
                  {e.data.unit && <span class="muted"> · {e.data.unit}</span>}
                </p>
                <ul class="highlights">
                  {e.data.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    position: relative;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr);
    gap: var(--space-l);
    padding-bottom: var(--space-xl);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  /* the spine */
  .entry::before {
    content: '';
    position: absolute;
    left: calc(min(15rem, 30%) + var(--space-l) / 2);
    top: 0.6rem;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }

  .entry:last-child::before {
    bottom: auto;
    height: 3rem;
    background: linear-gradient(var(--line-strong), transparent);
  }

  /* the node */
  .entry::after {
    content: '';
    position: absolute;
    left: calc(min(15rem, 30%) + var(--space-l) / 2 - 6px);
    top: 0.45rem;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
  }

  .entry:first-child::after {
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }

  .entry:target .what {
    outline: 2px solid var(--accent);
    outline-offset: 12px;
    border-radius: 4px;
  }

  .when {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    text-align: right;
    padding-right: var(--space-m);
  }

  .kind {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dates {
    color: var(--ink-soft);
  }

  .what {
    padding-left: var(--space-m);
    display: grid;
    gap: 0.5rem;
    max-width: 50rem;
  }

  .what h2 {
    font-size: var(--step-3);
  }

  .org {
    font-size: var(--step-0);
    font-weight: 500;
  }

  .highlights {
    margin-top: 0.5rem;
    padding-left: 1.1em;
    color: var(--ink-soft);
    display: grid;
    gap: 0.5rem;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  @media (max-width: 44rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      padding-left: 1.75rem;
    }

    .entry::before {
      left: 0.35rem;
    }

    .entry::after {
      left: 0;
    }

    .when {
      text-align: left;
      padding-right: 0;
    }

    .what {
      padding-left: 0;
    }
  }
</style>
