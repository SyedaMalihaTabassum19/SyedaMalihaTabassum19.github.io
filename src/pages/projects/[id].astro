---
import { getEntries, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactBand from '@/components/ContactBand.astro';
import Gallery from '@/components/Gallery.astro';
import Icon from '@/components/Icon.astro';
import LinkList from '@/components/LinkList.astro';
import Pager from '@/components/Pager.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import { labelFor, projectCategories } from '@/data/taxonomy';
import { getProjects, getSkills, type Project } from '@/lib/content';
import { formatRange } from '@/lib/format';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, index: i + 1, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props {
  entry: Project;
  index: number;
  prev?: Project;
  next?: Project;
}

const { entry, index, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const videos = d.media.filter((m) => m.type === 'youtube');
const images = d.media.filter((m) => m.type === 'image');
const related = await getEntries(d.relatedResearch);
const skills = (await getSkills()).flatMap((group) =>
  group.data.items.filter((item) => item.usedIn?.projects.some((p) => p.id === entry.id)).map((item) => item.name),
);
const primary = d.links.find((l) => l.kind === 'website') ?? d.links.find((l) => l.kind === 'repository');
const categoryLabels = d.categories.map((c) => labelFor(projectCategories, c));
---

<BaseLayout title={d.title} description={`${d.tagline} ${d.summary}`} type="article">
  <article>
    <header class="detail-header">
      <div class="wrap head-grid">
        <div class="head-text">
          <Breadcrumbs items={[{ label: 'Projects', href: 'projects/' }]} current={d.title} />
          <p class="eyebrow eyebrow--accent enter" style="--enter-step:0">{categoryLabels.join(' · ')}</p>
          <h1 class="enter" style="--enter-step:1">{d.title}</h1>
          <p class="lead enter" style="--enter-step:2">{d.tagline}</p>
          <div class="head-actions enter" style="--enter-step:3">
            <span class="mono muted">{formatRange(d.start, d.end)}</span>
            {
              primary && (
                <a class="btn btn--primary btn--small" href={primary.url} target="_blank" rel="noopener noreferrer">
                  {primary.label} <Icon name="arrow-up-right" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              )
            }
            {videos.length > 0 && (
              <a class="btn btn--small" href="#demo">
                <Icon name="play" /> Watch demo
              </a>
            )}
          </div>
        </div>
        {videos.length === 0 && <ProjectCover class="head-cover" id={entry.id} category={d.categories[0]} index={index} />}
      </div>
    </header>

    {
      videos.length > 0 && (
        <section class="demo" id="demo" aria-labelledby="demo-title">
          <div class="wrap">
            <h2 id="demo-title" class="eyebrow eyebrow--accent">
              Demo
            </h2>
            {videos.map((v) => (
              <YouTubeEmbed videoId={v.videoId} title={v.title} caption={v.caption} hostedBy={v.hostedBy} />
            ))}
          </div>
        </section>
      )
    }

    <div class="section">
      <div class="wrap detail-grid">
        <div class="detail-main">
          <section aria-labelledby="overview-title">
            <h2 id="overview-title" class="section-label">Overview</h2>
            <p class="overview">{d.summary}</p>
          </section>

          {
            hasBody && (
              <section class="prose" aria-label="Case study">
                <Content />
              </section>
            )
          }

          {
            d.technologies.length > 0 && (
              <section aria-labelledby="tech-title">
                <h2 id="tech-title" class="section-label">
                  Technologies & methods
                </h2>
                <ul class="tech">
                  {d.technologies.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            images.length > 0 && (
              <section aria-labelledby="gallery-title">
                <h2 id="gallery-title" class="section-label">
                  Gallery
                </h2>
                <Gallery images={images} label={`Images from ${d.title}`} />
              </section>
            )
          }

          {
            related.length > 0 && (
              <section aria-labelledby="related-title">
                <h2 id="related-title" class="section-label">
                  Related research
                </h2>
                <ul class="related">
                  {related.map((r) => (
                    <li>
                      <StatusBadge status={r.data.status} />
                      <a href={withBase(`research/${r.id}/`)}>{r.data.shortTitle ?? r.data.title}</a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>

        <aside class="detail-aside" aria-label="Project details">
          <dl class="facts">
            <div>
              <dt>Period</dt>
              <dd>{formatRange(d.start, d.end)}</dd>
            </div>
            <div>
              <dt>Category</dt>
              <dd>{categoryLabels.join(', ')}</dd>
            </div>
            {
              skills.length > 0 && (
                <div>
                  <dt>Skills applied</dt>
                  <dd>{skills.join(', ')}</dd>
                </div>
              )
            }
            {
              d.credits.length > 0 && (
                <div>
                  <dt>Team & credits</dt>
                  <dd>
                    <ul class="credits">
                      {d.credits.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
          {d.links.length > 0 && <LinkList links={d.links} context={d.title} />}
        </aside>
      </div>
    </div>

    <Pager
      label="More projects"
      prevLabel="Previous project"
      nextLabel="Next project"
      prev={prev && { href: `projects/${prev.id}/`, title: prev.data.title }}
      next={next && { href: `projects/${next.id}/`, title: next.data.title }}
    />
  </article>

  <ContactBand
    title="Want the details behind this build?"
    text="I’m happy to walk through the design decisions, hardware or code. Email is the quickest way to reach me."
  />
</BaseLayout>

<style>
  .detail-header {
    padding-block: var(--space-l) var(--space-xl);
    border-bottom: 1px solid var(--line);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: end;
  }

  .head-text {
    display: grid;
    gap: var(--space-s);
  }

  .head-text .eyebrow {
    margin-top: var(--space-m);
  }

  h1 {
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: var(--space-xs);
  }

  .demo {
    padding-block: var(--space-xl) 0;
  }

  .demo .wrap {
    display: grid;
    gap: var(--space-s);
    max-width: calc(64rem + var(--gutter) * 2);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .detail-main {
    display: grid;
    gap: var(--space-xl);
  }

  .section-label {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-s);
  }

  .overview {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    line-height: 1.4;
    max-width: 40ch;
  }

  .tech {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .tech li {
    padding: 0.8rem 0.8rem 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }

  .tech li::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.6rem;
    border-radius: 1px;
    background: var(--accent);
    vertical-align: middle;
  }

  .related {
    list-style: none;
    padding: 0;
  }

  .related li {
    display: grid;
    gap: 0.3rem;
    padding-block: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .related a {
    font-family: var(--font-display-stack);
    font-size: var(--step-1);
    text-decoration: none;
  }

  .detail-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: var(--space-m);
  }

  .facts {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-elev);
    font-size: var(--step--1);
  }

  .facts dt {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin-top: 0.2rem;
  }

  .credits {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }


  @media (max-width: 56rem) {
    .head-grid,
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .detail-aside {
      position: static;
    }
  }

</style>
