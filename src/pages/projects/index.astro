---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import FilterControls from '@/components/FilterControls.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import Icon from '@/components/Icon.astro';
import { labelFor, projectCategories } from '@/data/taxonomy';
import { getProjects } from '@/lib/content';
import { formatRange } from '@/lib/format';
import { withBase } from '@/lib/url';

const projects = await getProjects();
const categories = projectCategories
  .map((c) => ({ id: c.id, label: c.label, count: projects.filter((p) => p.data.categories.includes(c.id)).length }))
  .filter((c) => c.count > 0);

const mediaBadges = (p: (typeof projects)[number]) => {
  const out: string[] = [];
  if (p.data.media.some((m) => m.type === 'youtube')) out.push('Video demo');
  if (p.data.media.some((m) => m.type === 'image')) out.push('Gallery');
  if (p.data.links.some((l) => l.kind === 'website')) out.push('Live site');
  if (p.data.links.some((l) => l.kind === 'repository')) out.push('Code');
  if (p.data.links.some((l) => l.kind === 'report')) out.push('Report');
  return out;
};
---

<BaseLayout
  title="Projects"
  description="Engineering projects by Syeda Maliha Tabassum — autonomous robots, embedded health monitoring, machine learning pipelines and full-stack health platforms."
>
  <PageHeader
    eyebrow="Projects"
    title="Systems built end to end"
    lead="Robotics, embedded sensing, machine learning and full-stack platforms — each with its own case study, links and, where available, a demo."
  />

  <section class="section projects-section" aria-label="Project list">
    <div class="wrap" data-filter-root data-filter-noun="project|projects">
      <FilterControls facets={[{ name: 'category', legend: 'Category', total: projects.length, options: categories }]} />

      <p class="count mono" data-filter-count role="status" aria-live="polite" aria-atomic="true">
        {projects.length} projects
      </p>

      <ol class="index">
        {
          projects.map((p, i) => (
            <li
              class="row"
              data-filter-item
              data-category={p.data.categories.join(' ')}
              data-search={`${p.data.title} ${p.data.summary}`.toLowerCase()}
              data-reveal
            >
              <a class="row-link" href={withBase(`projects/${p.id}/`)}>
                <span class="n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="main">
                  <span class="eyebrow">{p.data.categories.map((c) => labelFor(projectCategories, c)).join(' · ')}</span>
                  <h2 class="title">{p.data.title}</h2>
                  <span class="tagline">{p.data.tagline}</span>
                  <span class="badges">
                    <span class="mono muted">{formatRange(p.data.start, p.data.end)}</span>
                    {mediaBadges(p).map((b) => (
                      <span class="chip">{b}</span>
                    ))}
                  </span>
                </span>
                <span class="thumb">
                  <ProjectCover id={p.id} category={p.data.categories[0]} index={i + 1} />
                </span>
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-right" size={22} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="empty" data-filter-empty hidden>
        <p class="empty-title">No projects in that category.</p>
        <button type="button" class="btn" data-filter-reset>Show all projects</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-section {
    padding-top: var(--space-xl);
  }

  .count {
    margin-block: var(--space-m) var(--space-s);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .index {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .row {
    border-top: 1px solid var(--line);
  }

  .row-link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(12rem, 18rem) 2rem;
    align-items: center;
    gap: var(--space-l);
    padding-block: var(--space-l);
    text-decoration: none;
  }

  .n {
    align-self: start;
    font-family: var(--font-display-stack);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
  }

  .main {
    display: grid;
    gap: 0.5rem;
  }

  .title {
    font-size: var(--step-3);
    line-height: 1.1;
    transition: color var(--dur);
  }

  .tagline {
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 0.25rem;
  }

  .thumb :global(.cover) {
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }

  .go {
    color: var(--muted);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur);
  }

  .row-link:hover .title,
  .row-link:hover .go {
    color: var(--accent);
  }

  .row-link:hover .go {
    transform: translateX(4px);
  }

  .row-link:hover .thumb :global(.cover) {
    transform: rotate(-1.2deg) scale(1.02);
    box-shadow: var(--shadow);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding: var(--space-xl) var(--space-l);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-l);
    margin-top: var(--space-m);
  }

  .empty-title {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
  }

  @media (max-width: 56rem) {
    .row-link {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: var(--space-s) var(--space-m);
    }

    .thumb {
      grid-column: 2;
      grid-row: 1;
    }

    .main {
      grid-column: 2;
    }

    .n {
      grid-row: 1 / span 2;
    }

    .go {
      display: none;
    }
  }
</style>
