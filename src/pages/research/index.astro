---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import FilterControls from '@/components/FilterControls.astro';
import ResearchItem from '@/components/ResearchItem.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { researchStatuses, researchTopics } from '@/data/taxonomy';
import { getResearch } from '@/lib/content';

const research = await getResearch();

const statuses = researchStatuses
  .map((s) => ({ ...s, entries: research.filter((r) => r.data.status === s.id) }))
  .filter((s) => s.entries.length > 0);

const topics = researchTopics
  .map((t) => ({ id: t.id, label: t.label, count: research.filter((r) => r.data.topics.includes(t.id)).length }))
  .filter((t) => t.count > 0);

const groupHeadings: Record<string, string> = {
  published: 'Published',
  accepted: 'Accepted',
  'under-review': 'Under review',
  'in-progress': 'In progress',
};
---

<BaseLayout
  title="Research & Publications"
  description="Publications, manuscripts under review and ongoing research by Syeda Maliha Tabassum — reliable and calibrated AI, 3D perception, health AI and assistive agentic systems."
>
  <PageHeader
    eyebrow="Research"
    title="Research & publications"
    lead="Peer-reviewed work, manuscripts in review and ongoing projects across reliable AI, 3D perception, health and assistive systems."
  >
    <dl class="legend">
      {
        statuses.map((s) => (
          <div>
            <dt>
              <StatusBadge status={s.id} />
            </dt>
            <dd>{s.note}</dd>
          </div>
        ))
      }
    </dl>
  </PageHeader>

  <section class="section research-section" aria-label="Research list">
    <div class="wrap" data-filter-root data-filter-noun="entry|entries">
      <FilterControls
        searchLabel="Search titles, topics, venues and authors"
        searchPlaceholder="e.g. calibration, ultrasound, 3D"
        facets={[
          {
            name: 'status',
            legend: 'Status',
            total: research.length,
            options: statuses.map((s) => ({ id: s.id, label: s.label, count: s.entries.length })),
          },
          { name: 'topic', legend: 'Topic', total: research.length, options: topics },
        ]}
      />

      <p class="count mono" data-filter-count role="status" aria-live="polite" aria-atomic="true">
        {research.length} entries
      </p>

      {
        statuses.map((s) => (
          <div class="group" data-filter-group>
            <h2 class="group-title" id={`group-${s.id}`}>
              {groupHeadings[s.id]}
              <span class="mono muted">{s.entries.length}</span>
            </h2>
            <ol class="list" aria-labelledby={`group-${s.id}`}>
              {s.entries.map((entry) => (
                <ResearchItem entry={entry} filterable />
              ))}
            </ol>
          </div>
        ))
      }

      <div class="empty" data-filter-empty hidden>
        <p class="empty-title">No research matches those filters.</p>
        <p class="muted">Try a different topic or status, or a shorter search term.</p>
        <button type="button" class="btn" data-filter-reset>Reset filters</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-s) var(--space-l);
    margin-top: var(--space-l);
    max-width: 60rem;
  }

  .legend dd {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .research-section {
    padding-top: var(--space-xl);
  }

  .count {
    margin-block: var(--space-m) var(--space-s);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .group + .group {
    margin-top: var(--space-xl);
  }

  .group-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--step-3);
    padding-bottom: var(--space-xs);
  }

  .group-title .mono {
    font-size: var(--step--1);
  }

  .list {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding: var(--space-xl) var(--space-l);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-l);
    margin-top: var(--space-m);
  }

  .empty-title {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
  }
</style>
