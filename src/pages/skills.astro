---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import ContactBand from '@/components/ContactBand.astro';
import { getSkills, resolveEvidence } from '@/lib/content';
import { withBase } from '@/lib/url';

const groups = await Promise.all(
  (await getSkills()).map(async (group) => ({
    ...group.data,
    items: await Promise.all(
      group.data.items.map(async (item) => ({ name: item.name, evidence: await resolveEvidence(item.usedIn) })),
    ),
  })),
);
---

<BaseLayout
  title="Skills"
  description="Technical skills of Syeda Maliha Tabassum — machine learning, computer vision, agentic systems, robotics and embedded systems — linked to the projects and research where they were used."
>
  <PageHeader
    eyebrow="Skills"
    title="Skills, and where they show up"
    lead="Grouped by area. Skills marked with a dot link to the projects, research or roles where they were used — open one to see where."
  />

  <section class="section">
    <div class="wrap groups">
      {
        groups.map((group, gi) => (
          <section class="group" aria-labelledby={`skills-${group.id}`} data-reveal>
            <header class="group-head">
              <span class="group-n" aria-hidden="true">
                {String(gi + 1).padStart(2, '0')}
              </span>
              <h2 id={`skills-${group.id}`}>{group.label}</h2>
              <p>{group.description}</p>
            </header>
            <ul class="items">
              {group.items.map((item) =>
                item.evidence.length > 0 ? (
                  <li class="item has-evidence">
                    <details>
                      <summary>
                        <span class="dot" aria-hidden="true" />
                        {item.name}
                        <span class="visually-hidden">— show where this was used</span>
                      </summary>
                      <ul class="evidence">
                        {item.evidence.map((ev) => (
                          <li>
                            <span class="ev-kind">{ev.kind}</span>
                            <a href={withBase(ev.href)}>
                              {ev.label} <Icon name="arrow-right" />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li class="item">{item.name}</li>
                ),
              )}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: 0;
  }

  .group {
    display: grid;
    grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-l);
    border-top: 1px solid var(--line-strong);
  }

  .group-head {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .group-n {
    font-family: var(--font-display-stack);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--accent);
    line-height: 1;
  }

  .group-head h2 {
    font-size: var(--step-2);
  }

  .group-head p {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .item {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 500;
    background: var(--bg-elev);
  }

  .item.has-evidence {
    padding: 0;
    border-color: var(--line-strong);
  }

  details[open] {
    border-radius: var(--radius-l);
  }

  .item.has-evidence:has(details[open]) {
    flex-basis: 100%;
    border-radius: var(--radius-l);
    border-color: var(--accent);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-family: var(--font-mono-stack);
    color: var(--muted);
  }

  details[open] summary::after {
    content: '−';
  }

  summary:hover {
    color: var(--accent);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .evidence {
    list-style: none;
    padding: 0 0.95rem 0.8rem;
    display: grid;
    gap: 0.35rem;
  }

  .evidence li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.6rem;
    align-items: baseline;
  }

  .ev-kind {
    font-family: var(--font-mono-stack);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .evidence a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    font-weight: 500;
  }

  @media (max-width: 48rem) {
    .group {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .evidence li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
